ADMIN_TELEGRAM_ID=0

# ── Encryption key (user API keys at rest) ────────────────────
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────
NOVA_DB=./nova.db

# ── Branding ──────────────────────────────────────────────────
BROKER_CODE=Kr000820
AFFILIATE_ID=127146

# ── Bybit broker (admin commands only) ────────────────────────
BYBIT_BROKER_KEY=
BYBIT_BROKER_SECRET=

# ── Bybit OAuth (callback server) ─────────────────────────────
BYBIT_CLIENT_ID=x9dmxAGkDDoa
BYBIT_CLIENT_SECRET=
